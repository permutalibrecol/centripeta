<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO ESTRATÉGICO Y PROFESIONAL -->
    <title>{{ title }} | Centrípeta Marketing</title>
    <meta name="description" content="Ecosistema de desarrollo premium y marketing de conversión. Creamos plataformas ultra rápidas y aplicaciones transaccionales a medida.">
    <meta name="keywords" content="Marketing Digital, Desarrollo Web, Astro, Fintech, Criptomonedas, Google Sites, Bogotá, Chía, Costa Rica">
    <meta name="author" content="Centrípeta Marketing">
    
    <!-- Open Graph / Facebook / WhatsApp Lead Cards -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://github.io">
    <meta property="og:title" content="Centrípeta Marketing | Interfaces de Alto Rendimiento">
    <meta property="og:description" content="Ecosistemas a medida, aplicaciones Fintech y optimización en la nube con velocidad inferior a 0.5s.">
    <meta property="og:image" content="https://github.ioassets/seo-banner.jpg">

    <!-- Twitter Developer Card -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://github.io">
    <meta property="twitter:title" content="Centrípeta Marketing | Interfaces de Alto Rendimiento">
    <meta property="twitter:description" content="Desarrollo premium y optimización digital avanzada para marcas de alto impacto.">

    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg: #030712;
            --surface: rgba(17, 24, 39, 0.7);
            --primary: #ffffff;
            --accent: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.4);
            --accent-lime: #a3e635;
            --text-muted: #9ca3af;
            --border: rgba(255, 255, 255, 0.08);
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            color: var(--primary); 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column;
            overflow-x: hidden;
            position: relative;
        }

        /* Fondo Animado de Gradientes Líquidos */
        body::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
            top: -10%;
            right: -10%;
            z-index: -1;
            animation: floatGlow 12s infinite alternate ease-in-out;
        }

        @keyframes floatGlow {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-80px, 50px); }
        }

        .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; width: 100%; }
        
        /* Navbar de Cristal Flotante (Glassmorphism) */
        .navbar { 
            background: rgba(3, 7, 18, 0.6); 
            backdrop-filter: blur(20px); 
            -webkit-backdrop-filter: blur(20px);
            position: sticky; 
            top: 0; 
            z-index: 100; 
            border-bottom: 1px solid var(--border); 
        }
        .nav-container { height: 85px; display: flex; justify-content: space-between; align-items: center; }
        .brand-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
        .logo-icon { width: 40px; height: 40px; filter: drop-shadow(0 0 8px var(--accent-glow)); }
        .logo-text { font-size: 1.5rem; font-weight: 700; color: var(--primary); letter-spacing: -0.03em; }
        
        .nav-menu { display: flex; align-items: center; gap: 2rem; }
        .nav-menu a { text-decoration: none; color: var(--text-muted); font-weight: 500; font-size: 0.95rem; transition: all 0.3s ease; position: relative; }
        .nav-menu a:hover { color: var(--primary); }
        
        /* Botón de Acción con Brillo */
        .nav-menu .btn-nav { 
            background: linear-gradient(135deg, var(--accent) 0%, #1d4ed8 100%); 
            color: white; 
            padding: 0.6rem 1.4rem; 
            border-radius: 10px; 
            font-weight: 600; 
            box-shadow: 0 4px 14px var(--accent-glow);
        }
        .nav-menu .btn-nav:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6);
        }

        main { flex-grow: 1; }

        /* Footer Tecnológico */
        .footer { padding: 6rem 0 3rem; background: #0b0f19; border-top: 1px solid var(--border); position: relative; }
        .footer-container { display: flex; flex-direction: column; gap: 2.5rem; text-align: center; }
        .email-link { font-size: 1.6rem; color: var(--accent-lime); font-weight: 700; text-decoration: none; letter-spacing: -0.02em; filter: drop-shadow(0 0 10px rgba(163, 230, 53, 0.2)); transition: all 0.3s; }
        .email-link:hover { color: white; filter: drop-shadow(0 0 15px rgba(255,255,255,0.4)); }
        .footer-legal { border-top: 1px solid var(--border); padding-top: 2rem; font-size: 0.85rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 1rem; }
        .legal-links { display: flex; justify-content: center; gap: 2rem; }
        .legal-links a { color: var(--text-muted); text-decoration: none; font-weight: 500; transition: color 0.2s; }
        .legal-links a:hover { color: var(--accent); }
        
        @media (max-width: 768px) { .nav-menu { display: none; } .legal-links { flex-direction: column; gap: 0.75rem; } }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="container nav-container">
            <a href="/centripeta/" class="brand-logo">
                <svg viewBox="0 0 120 100" class="logo-icon" xmlns="http://w3.org">
                    <path d="M 20,50 A 30,30 0 1,1 80,50" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
                    <path d="M 15,50 C 15,75 35,80 50,80 C 65,80 85,75 85,50 Z" fill="none" stroke="#ffffff" stroke-width="4" stroke-linejoin="round" />
                    <path d="M 15,55 C 5,55 5,70 15,70" fill="none" stroke="#ffffff" stroke-width="3" />
                    <path d="M 30,88 L 70,88" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
                    <path d="M 52,56 L 46,67 L 51,67 L 48,76 L 56,65 L 51,65 Z" fill="#a3e635" />
                    <path d="M 50,50 C 50,30 65,25 72,15" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" />
                    <g transform="translate(67, 5) rotate(25)">
                        <path d="M 6,0 C 10,6 10,14 8,20 L 4,20 C 2,14 2,6 6,0 Z" fill="#a3e635" />
                    </g>
                </svg>
                <span class="logo-text">Centrípeta</span>
            </a>
            <nav class="nav-menu">
                <a href="/centripeta/">Home</a>
                <a href="/centripeta/nosotros/">Nosotros</a>
                <a href="/centripeta/blog/">Blog</a>
                <a href="/centripeta/contacto/" class="btn-nav">Contacto</a>
            </nav>
        </div>
    </header>

    <main>
        {{ content | safe }}
    </main>

    <footer class="footer">
        <div class="container footer-container">
            <div class="footer-contact">
                <a href="mailto:agenciacentripeta@gmail.com" class="email-link">agenciacentripeta@gmail.com</a>
            </div>
            <div class="footer-legal">
                <p>&reg; Centrípeta Marketing. Todos los derechos reservados 2024 - 2026</p>
                <div class="legal-links">
                    <a href="/centripeta/politica-privacidad/">Política de Privacidad</a>
                    <a href="/centripeta/politica-cookies/">Política de cookies</a>
                    <a href="/centripeta/aviso-legal/">Aviso legal</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
