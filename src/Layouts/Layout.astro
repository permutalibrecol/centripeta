---
// src/layouts/Layout.astro
import Logo from '../components/Logo.astro';

const { title, description = "Centrípeta Marketing - Tu aliado estratégico." } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://googleapis.com">
		<link rel="preconnect" href="https://gstatic.com" crossorigin>
		<link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="navbar">
			<div class="container nav-container">
				<a href="/" class="logo-link">
					<Logo />
				</a>
				<nav class="nav-menu">
					<a href="/">Home</a>
					<a href="/nosotros">Nosotros</a>
					<a href="/blog">Blog</a>
					<a href="/contacto" class="btn-nav">Contacto</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="container footer-container">
				<div class="footer-contact">
					<p>Contacto directo:</p>
					<a href="mailto:agenciacentripeta@gmail.com" class="email-link">agenciacentripeta@gmail.com</a>
				</div>
				<div class="footer-legal">
					<p>&reg; Centrípeta 2024 - {new Date().getFullYear()}</p>
					<div class="legal-links">
						<a href="/politica-privacidad">Política de Privacidad</a>
						<a href="/politica-cookies">Política de cookies</a>
						<a href="/aviso-legal">Aviso legal</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root { --primary: #0f172a; --accent: #2563eb; --background: #ffffff; --surface: #f8fafc; --text: #1e293b; --text-muted: #64748b; --border: #e2e8f0; }
	* { box-sizing: border-box; margin: 0; padding: 0; }
	html { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: var(--background); color: var(--text); scroll-behavior: smooth; }
	body { min-height: 100vh; display: flex; flex-direction: column; }
	.container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
	.navbar { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--border); }
	.nav-container { height: 80px; display: flex; justify-content: space-between; align-items: center; }
	.logo-link { text-decoration: none; display: flex; align-items: center; }
	.logo-text { color: var(--primary) !important; font-size: 1.65rem; font-weight: 700; letter-spacing: -0.02em; }
	.nav-menu a { text-decoration: none; color: var(--text-muted); font-weight: 500; margin-left: 2rem; transition: color 0.2s; font-size: 0.95rem; }
	.nav-menu a:hover { color: var(--primary); }
	.nav-menu .btn-nav { background: var(--primary); color: white !important; padding: 0.5rem 1.2rem; border-radius: 6px; }
	.nav-menu .btn-nav:hover { background: var(--accent); }
	.footer { margin-top: auto; padding: 4rem 0 2rem; background: var(--surface); border-top: 1px solid var(--border); }
	.footer-container { display: flex; flex-direction: column; gap: 2rem; text-align: center; }
	.email-link { font-size: 1.25rem; color: var(--accent); font-weight: 600; text-decoration: none; }
	.footer-legal { border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 1rem; }
	.legal-links { display: flex; justify-content: center; gap: 1.5rem; }
	.legal-links a { color: var(--text-muted); text-decoration: none; }
	.legal-links a:hover { color: var(--accent); }
	@media (max-width: 768px) { .nav-menu { display: none; } .legal-links { flex-direction: column; gap: 0.5rem; } }
</style>
