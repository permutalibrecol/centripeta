---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// PARRILLA DE TUS 5 CLIENTES REALES
const clientsPortfolios = [
	{
		title: "Plataforma Fintech de Intercambio Cripto a Efectivo",
		client: "Permuta Libre Colombia",
		type: "app",
		url: "https://permutalibre.com.co",
		description: "Pasarela financiera para el retiro de criptoactivos (BTC, ETH, USDC) a efectivo físico en Bogotá y Chía. Estructura un modelo transaccional fijo de $2.000.000 COP con validación P2P sin fricción bancaria."
	},
	{
		title: "Portal Industrial Global de Suministros ASME",
		client: "Vanguard Supply USA",
		type: "astro",
		url: "https://dsvanguard.com",
		description: "Plataforma internacional de distribución industrial para infraestructura crítica. Incorpora un portal corporativo técnico de cotizaciones RFQ con enrutamiento inteligente de ofertas."
	},
	{
		title: "Plataforma Médica de Fisioterapia a Domicilio",
		client: "TuFisioOficial (Dra. Steffany González)",
		type: "gsites",
		url: "https://tufisiooficial.com",
		description: "Landing page de servicios de salud domiciliarios en Bogotá optimizada para conversiones. Integra embudo directo a WhatsApp, catálogo de tratamientos y sección interactiva de diplomas médicos."
	},
	{
		title: "Ecosistema de Educación Nutricional y Tienda Virtual",
		client: "Aliméntate Saludable Hoy (Astrid)",
		type: "gsites",
		url: "https://alimentatesaludablehoy.com",
		description: "Plataforma de bienestar integral con catálogo estructurado de suplementos y bebidas herbales. Cuenta con sistema interactivo de carrito de compras nativo con confirmación de pedidos vía WhatsApp."
	},
	{
		title: "Plataforma Web Corporativa de Radiología Avanzada",
		client: "Centro de Imágenes Médicas Doctores Salvatierra",
		type: "gsites",
		url: "https://doctoressalvatierra.com",
		description: "Sitio web médico especializado para una clínica líder en San Carlos, Costa Rica. Estructura un catálogo completo de servicios (TAC, Mamografía, Ultrasonidos) y perfiles profesionales de especialistas."
	}
];
---

<Layout title="Centrípeta Marketing | Vitrina de Soluciones Digitales">
	<!-- Hero de Ventas -->
	<section class="hero-section">
		<div class="container">
			<div class="hero-content">
				<h1>Bienvenido a <span class="brand-gradient">Centrípeta Marketing</span></h1>
				<h2>Tu aliado estratégico en el desarrollo y optimización digital.</h2>
				<p>Transformamos visiones comerciales en plataformas de alto rendimiento. Diseñamos ecosistemas robustos desde aplicaciones web dinámicas y arquitecturas estáticas ultra rápidas en Astro hasta landing pages ágiles en la nube de Google Sites.</p>
				<div class="hero-actions">
					<a href="/contacto" class="btn-hero-primary">Cotizar mi Proyecto</a>
					<a href="#portafolio" class="btn-hero-secondary">Explorar Casos de Éxito</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Métricas Clave -->
	<section class="stats-section">
		<div class="container grid-stats">
			<div class="stat-item">
				<span class="stat-number">100%</span>
				<span class="stat-label">Disponibilidad Cloud sin Caídas</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">&lt; 1s</span>
				<span class="stat-label">Tiempo de Carga en Desarrollos Astro</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">0$</span>
				<span class="stat-label">Costos Mensuales de Servidor (G-Sites)</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">5.000+</span>
				<span class="stat-label">Usuarios e Impacto en Clientes Reales</span>
			</div>
		</div>
	</section>

	<!-- Portafolio -->
	<section id="portafolio" class="portfolio-section">
		<div class="container">
			<div class="section-title-block">
				<h2>Selected work</h2>
				<p>Explora soluciones reales creadas para empresas, startups y profesionales que necesitaban potenciar su marca, procesar transacciones seguras y optimizar su presencia digital.</p>
				<div class="divider"></div>
			</div>
			
			<div class="portfolio-grid">
				{clientsPortfolios.map(project => (
					<ProjectCard 
						title={project.title} 
						client={project.client}
						type={project.type}
						url={project.url}
						description={project.description}
					/>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero-section {
		padding: 8rem 0 5rem;
		background: radial-gradient(circle at 90% 10%, #eff6ff 0%, #ffffff 60%);
	}
	.hero-content { max-width: 800px; }
	.hero-content h1 { font-size: 1.5rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
	.brand-gradient { color: var(--primary); }
	.hero-content h2 { font-size: 2.8rem; font-weight: 700; color: var(--primary); line-height: 1.2; letter-spacing: -0.03em; margin-bottom: 1.5rem; }
	.hero-content p { font-size: 1.2rem; line-height: 1.6; color: var(--text-muted); margin-bottom: 2.5rem; }
	
	.hero-actions { display: flex; gap: 1rem; }
	.btn-hero-primary { text-decoration: none; background: var(--accent); color: white; padding: 0.8rem 1.8rem; border-radius: 8px; font-weight: 600; transition: background 0.2s; }
	.btn-hero-primary:hover { background: var(--primary); }
	.btn-hero-secondary { text-decoration: none; border: 1px solid var(--border); color: var(--primary); padding: 0.8rem 1.8rem; border-radius: 8px; font-weight: 600; transition: background 0.2s; }
	.btn-hero-secondary:hover { background: var(--surface); }

	.stats-section { padding: 3rem 0; background: var(--surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
	.grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: center; }
	.stat-number { display: block; font-size: 2.2rem; font-weight: 700; color: var(--primary); }
	.stat-label { font-size: 0.9rem; color: var(--text-muted); font-weight: 500; }

	.portfolio-section { padding: 6rem 0 8rem; }
	.section-title-block { margin-bottom: 4rem; }
	.section-title-block h2 { font-size: 2rem; font-weight: 700; color: var(--primary); margin-bottom: 0.5rem; }
	.section-title-block p { color: var(--text-muted); font-size: 1.1rem; }
	.divider { width: 50px; height: 4px; background: var(--accent); margin-top: 1rem; border-radius: 2px; }
	.portfolio-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; }

	@media (max-width: 640px) {
		.hero-content h2 { font-size: 2rem; }
		.hero-actions { flex-direction: column; }
		.btn-hero-primary, .btn-hero-secondary { text-align: center; }
	}
</style>
