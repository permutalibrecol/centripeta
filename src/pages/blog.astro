---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';

// ARTÍCULOS ESTRATÉGICOS ORIENTADOS A CONVERTIR LECTORES EN CLIENTES
const posts = [
	{
		title: "El fin de los sitios web lentos: Por qué migrar de constructores visuales a Astro",
		excerpt: "Analizamos el impacto financiero que tiene la velocidad de carga en un negocio y cómo la arquitectura estática de Astro elimina el JavaScript innecesario para vender más.",
		date: "Septiembre 2026",
		tag: "Desarrollo Web",
		readTime: "5 min de lectura"
	},
	{
		title: "Seguridad y Conversión en Plataformas Fintech: El Caso de Éxito de Permuta Libre",
		excerpt: "Cómo estructurar interfaces confiables para transacciones financieras complejas sin sobrecargar la experiencia del usuario final ni comprometer la seguridad.",
		date: "Agosto 2026",
		tag: "Fintech & Apps",
		readTime: "7 min de lectura"
	},
	{
		title: "Cómo convertir un catálogo digital básico en una máquina de ventas por WhatsApp",
		excerpt: "Estrategias de UI/UX aplicadas a la salud y el bienestar. Lecciones aprendidas optimizando flujos de conversión de servicios médicos a domicilio y tiendas de nutrición.",
		date: "Julio 2026",
		tag: "Marketing Digital",
		readTime: "4 min de lectura"
	}
];
---

<Layout title="Blog & Insights Digitales | Centrípeta Marketing" description="Artículos, análisis técnicos y estrategias sobre desarrollo de software rápido, marketing digital y optimización de plataformas de conversión.">
	<!-- Hero del Blog -->
	<section class="blog-hero">
		<div class="container">
			<span class="hero-tag">Conocimiento Estratégico</span>
			<h1>Insights, Tecnología y Estrategia Digital</h1>
			<p>Compartimos metodologías claras y análisis reales sobre cómo crear interfaces de alto rendimiento que transforman visitas en facturación.</p>
		</div>
	</section>

	<!-- Cuadrícula de Artículos -->
	<section class="blog-list-section">
		<div class="container">
			<div class="blog-grid">
				{posts.map(post => (
					<article class="post-card">
						<div class="post-header">
							<span class="post-badge">{post.tag}</span>
							<span class="post-time">{post.readTime}</span>
						</div>
						
						<div class="post-body">
							<span class="post-date">{post.date}</span>
							<h2>{post.title}</h2>
							<p>{post.excerpt}</p>
						</div>
						
						<div class="post-footer">
							<a href="#" class="btn-read-more">
								Leer artículo completo <span class="arrow">&rarr;</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- Banner de Llamado a la Acción (CTA) para Cierre de Ventas -->
	<section class="blog-cta">
		<div class="container">
			<div class="cta-box">
				<h2>¿Quieres aplicar estas mismas estrategias en tu empresa?</h2>
				<p>Diseñamos y programamos aplicaciones a la medida de tus necesidades comerciales, con código limpio y optimizado al 100%.</p>
				<a href="/contacto" class="btn-cta">Iniciar Consultoría Gratuita</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.blog-hero {
		padding: 8rem 0 4rem;
		background: #f8fafc;
		border-bottom: 1px solid var(--border);
	}
	.hero-tag {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--accent);
		letter-spacing: 0.05em;
		display: inline-block;
		margin-bottom: 0.75rem;
	}
	.blog-hero h1 {
		font-size: 2.8rem;
		font-weight: 700;
		color: var(--primary);
		letter-spacing: -0.03em;
		margin-bottom: 1rem;
		line-height: 1.2;
	}
	.blog-hero p {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 750px;
		line-height: 1.6;
	}

	/* Lista de publicaciones */
	.blog-list-section {
		padding: 5rem 0;
	}
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2.5rem;
	}
	
	.post-card {
		background: #ffffff;
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 380px;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.04);
		border-color: var(--accent);
	}

	.post-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
	}
	.post-badge {
		font-size: 0.75rem;
		font-weight: 700;
		background: var(--surface);
		color: var(--primary);
		padding: 0.25rem 0.75rem;
		border-radius: 6px;
		border: 1px solid var(--border);
	}
	.post-time {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.post-date {
		font-size: 0.85rem;
		color: var(--accent);
		font-weight: 600;
		display: block;
		margin-bottom: 0.5rem;
	}
	.post-body h2 {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--primary);
		line-height: 1.3;
		margin-bottom: 0.75rem;
	}
	.post-body p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.btn-read-more {
		text-decoration: none;
		color: var(--primary);
		font-weight: 600;
		font-size: 0.95rem;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		transition: color 0.2s;
	}
	.post-card:hover .btn-read-more {
		color: var(--accent);
	}
	.arrow {
		transition: transform 0.2s ease;
	}
	.post-card:hover .arrow {
		transform: translateX(4px);
	}

	/* Sección CTA */
	.blog-cta {
		padding-bottom: 6rem;
	}
	.cta-box {
		background: var(--primary);
		color: #ffffff;
		padding: 3.5rem 2rem;
		border-radius: 24px;
		text-align: center;
		max-width: 900px;
		margin: 0 auto;
		box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
	}
	.cta-box h2 {
		font-size: 2rem;
		font-weight: 700;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
	}
	.cta-box p {
		color: #94a3b8;
		max-width: 600px;
		margin: 0 auto 2rem;
		font-size: 1.1rem;
		line-height: 1.6;
	}
	.btn-cta {
		text-decoration: none;
		background: var(--accent);
		color: #ffffff;
		padding: 0.8rem 2rem;
		border-radius: 8px;
		font-weight: 600;
		display: inline-block;
		transition: background 0.2s;
	}
	.btn-cta:hover {
		background: #1d4ed8;
	}

	@media (max-width: 640px) {
		.blog-hero h1 { font-size: 2rem; }
		.cta-box h2 { font-size: 1.5rem; }
		.cta-box { padding: 2rem 1.5rem; }
	}
</style>

