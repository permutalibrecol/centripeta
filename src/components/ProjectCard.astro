---
// src/components/ProjectCard.astro
interface Props {
	title: string;
	client: string;
	type: 'astro' | 'app' | 'gsites';
	url: string;
	description: string;
}

const { title, client, type, url, description } = Astro.props;

// Etiquetas visuales dinámicas para tus clientes
const badgeStyles = {
	astro: { label: "Desarrollo Astro (Ultra Rápido)", color: "#4f46e5", bg: "#e0e7ff" },
	app: { label: "Aplicación Web", color: "#0891b2", bg: "#ecfeff" },
	gsites: { label: "Google Sites Cloud", color: "#d97706", bg: "#fef3c7" }
};

const currentBadge = badgeStyles[type];
---

<div class="project-card">
	<div class="project-header">
		<span class="tech-badge" style={`color: ${currentBadge.color}; background-color: ${currentBadge.bg};`}>
			{currentBadge.label}
		</span>
		<span class="client-name">👤 {client}</span>
	</div>
	
	<div class="project-body">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
	
	<div class="project-footer">
		<a href={url} target="_blank" rel="noopener noreferrer" class="btn-project-link">
			Visitar Sitio Oficial &rarr;
		</a>
	</div>
</div>

<style>
	.project-card {
		background: #ffffff;
		border-radius: 16px;
		border: 1px solid var(--border);
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 280px;
		transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
	}
	
	.project-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.08);
		border-color: var(--accent);
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.tech-badge {
		align-self: flex-start;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.client-name {
		font-size: 0.85rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	.project-body h3 {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--primary);
		margin-bottom: 0.5rem;
		line-height: 1.2;
	}

	.project-body p {
		font-size: 0.95rem;
		color: var(--text-muted);
		line-height: 1.5;
		margin-bottom: 1.5rem;
	}

	.btn-project-link {
		display: inline-block;
		text-decoration: none;
		color: var(--accent);
		font-weight: 600;
		font-size: 0.95rem;
		transition: color 0.2s;
	}

	.btn-project-link:hover {
		color: var(--primary);
	}
</style>

